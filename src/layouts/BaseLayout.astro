---
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import { getCurrentLocale } from '../i18n/utils';
import { getTranslations } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
}

const currentLocale = getCurrentLocale(Astro.currentLocale);
const translations = getTranslations(currentLocale);
const { title = translations.seo.metaTitle, description = translations.seo.metaDescription } = Astro.props;
---

<!DOCTYPE html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="generator" content={Astro.generator}/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" type="image/x-icon" href="/favicon.ico"/>
    <title>{title}</title>
    <meta name="description" content={description}/>
  </head>
  <body class="bg-background text-text font-sans min-h-screen antialiased">
    <slot/>
  </body>
  <script>
      import Lenis from 'lenis';

      document.addEventListener('astro:page-load', () => {
        const lenis = new Lenis({
          autoRaf: true,
          smoothWheel: true,
          lerp: 0.1,
        });
      });
    </script>
</html>
